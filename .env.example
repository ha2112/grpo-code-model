# Shared experimental controls
COMPARISON_MODEL=./model
COMPARISON_STEPS=5
COMPARISON_SEED=42
COMPARISON_LEARNING_RATE=1e-6
COMPARISON_TRAIN_BATCH_SIZE=32
COMPARISON_ROLLOUT_N=32
COMPARISON_MAX_PROMPT_LENGTH=4096
COMPARISON_MAX_RESPONSE_LENGTH=8192
COMPARISON_NGPUS=8
COMPARISON_NNODES=1

# Logging and run identity
COMPARISON_PROJECT=verl_grpo_afterburner_comparison
COMPARISON_PREFIX=pilot
COMPARISON_LOGGER=console
COMPARISON_RESUME_MODE=disable

# Paths may be absolute or relative to this repository.
COMPARISON_RUNS_DIR=./runs
COMPARISON_MODEL_CACHE_DIR=./model-cache
VENUS_DATA_DIR=${HOME}/data/venus
ABSOLUTE_DATA_DIR=./grpo_codeforces_curriculum/data
PROBE_DATA_DIR=./grpo_difficulty_probe/data

# Both Codeforces rewards use this endpoint. The Venus source currently uses
# https://monolith.cool/execute directly.
MONOLITH_URL=https://monolith.cool/execute

# Keep enabled for real runs. Smoke tests can override it temporarily.
COMPARISON_VALIDATE_DATA=true
